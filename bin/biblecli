#!/usr/bin/env bash
# Checkout launcher. For a standalone copy, install dist/biblecli (make zipapp).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [[ ! -f "${ROOT}/biblecli/__main__.py" ]]; then
  echo "biblecli: this script only works inside the sword-cli checkout." >&2
  echo "  From the repo:  ./bin/biblecli --help" >&2
  echo "  To install:     make zipapp && cp dist/biblecli ~/Applications/" >&2
  exit 1
fi
export PYTHONPATH="${ROOT}${PYTHONPATH:+:$PYTHONPATH}"
if [[ -x "$ROOT/.venv/bin/python" ]]; then
  exec "$ROOT/.venv/bin/python" -m biblecli "$@"
fi
exec python3 -m biblecli "$@"
